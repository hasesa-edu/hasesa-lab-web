GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Session cookie signing secret. Must be >= 32 chars. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Admin sign-in for /admin (analytics dashboard).
# Required in production (>= 8 chars) — the app fails closed if unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
