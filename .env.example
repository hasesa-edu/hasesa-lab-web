# Lab assistant: any OpenAI-compatible chat completions API. Defaults to Groq.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Only for reasoning models (e.g. gpt-oss): low | medium | high. Leave empty otherwise.
AI_REASONING_EFFORT=low

# Session cookie signing secret. Must be >= 32 chars. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Google sign-in (the only way students sign in). Create an OAuth client
# (Web application) in Google Cloud and register this redirect URI for every
# origin: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chapa payments. Use the CHASECK_TEST-... key until the account is approved.
CHAPA_SECRET_KEY=
# Webhook secret set in Chapa dashboard > Settings > Webhooks
# (webhook URL: https://<site>/api/billing/webhook).
CHAPA_WEBHOOK_SECRET=

# Support email shown on the Terms, Privacy and Refund pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Admin sign-in for /admin (analytics dashboard).
# Required in production (>= 8 chars) — the app fails closed if unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Postgres connection string (Neon). Used by the app and by drizzle-kit.
DATABASE_URL=

# Bearer token Vercel Cron sends to /api/cron/cleanup.
CRON_SECRET=

# Public base URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
